# VPS の /opt/umiyomi/.env.production に置く（git には入れない）。
# chmod 600 にすること。

# CI がデプロイのたびに SHA タグで上書きする（手で起動するときだけ使う）
# APP_IMAGE=ghcr.io/yanchi/umiyomi/app:latest

# ホストの nginx（deploy/nginx/umiyomi.conf）の proxy_pass と揃える
APP_PORT=8003

# openssl rand -hex 32
APP_SECRET=
# コマンドから URL を作るときの基準（https://ドメイン）
DEFAULT_URI=https://umiyomi.isl-mentor.com

# フィードバックの外部フォーム（任意）。どちらかが空、または URL が https:// で始まらない・# を含むときは、
# フッターにリンクを出さず /feedback は 404 になる。
# FEEDBACK_FORM_PREFILL_FIELD は、地点などを事前入力する欄の Query パラメータ名（Google フォームなら entry.123456789）。
# 調べ方は specs/004-feedback-channel/quickstart.md を参照
FEEDBACK_FORM_URL=
FEEDBACK_FORM_PREFILL_FIELD=
