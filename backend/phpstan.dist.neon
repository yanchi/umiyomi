parameters:
    level: max
    # bin/・config/・public/ は Symfony の雛形そのままのため、自分たちのコードだけを対象にする
    paths:
        - src/
        - tests/
    excludePaths:
        - tests/bootstrap.php
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    ignoreErrors:
        # Fake Provider・固定時計は when@test でだけ登録する。PHPStan は dev のコンテナを参照するため未登録に見える
        -
            identifier: symfonyContainer.serviceNotFound
            path: tests/Functional/*
