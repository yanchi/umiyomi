{% extends 'base.html.twig' %}

{% block title %}{{ page.location ?? '予報' }} | UMIYOMI{% endblock %}

{% block body %}
    <header class="page-header">
        <h1 class="site-title"><a href="{{ path('app_home') }}">UMIYOMI</a></h1>
    </header>
    {{ include('forecast/_form.html.twig', {form: page.form}) }}
    {{ include('favorites/_switch_list.html.twig') }}

    {# 古い予報や取得できなかったことを見落とさないよう、地点・一覧より前に置く #}
    {% if page.notice %}
        <p class="notice notice--{{ page.notice.type }}" role="alert">{{ page.notice.message }}</p>
    {% endif %}

    {% if page.location %}
        <h2 class="location">{{ page.location }}</h2>
    {% endif %}
    {% if page.lastUpdated %}
        <p class="last-updated">{{ page.lastUpdated }}</p>
    {% endif %}

    {# 取得失敗・回数制限でも保存できるよう予報の有無に関わらず出す。入力エラーのときは地点が決まらないので出さない #}
    {% if page.favoriteTarget %}
        {{ include('favorites/_save_panel.html.twig', {target: page.favoriteTarget}) }}
    {% endif %}

    <p class="disclaimer">この予報は航海の安全を保証するものではありません。出航前に気象庁などが発表する警報・注意報もあわせて確認してください。</p>

    {% if page.groupMessages is not empty %}
        <ul class="group-messages">
            {% for message in page.groupMessages %}
                <li>{{ message }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    {% if page.table %}
        {{ include('forecast/_table.html.twig', {table: page.table}) }}
    {% endif %}
{% endblock %}
